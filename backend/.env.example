# 이 파일을 .env로 복사해서 값을 채운다. 비어 있는 항목은 개발용 대체 기능으로 동작한다.

# 시청 링크와 카카오 로그인 redirect에 쓰이는 프론트엔드 주소
# 부모님 휴대폰에서 열어 보려면 배포 주소나 터널(ngrok, cloudflared) 주소로 바꿔야 한다
PUBLIC_BASE_URL=http://localhost:3000

# 세션 쿠키 서명 키 (배포 시 반드시 긴 임의 문자열로 설정)
SESSION_SECRET=

# 카카오 로그인 (developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키)
# Redirect URI 등록: {PUBLIC_BASE_URL}/api/auth/kakao/callback
# 비워 두면 이름만 입력하는 개발용 로그인이 켜진다
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# DEV_LOGIN=true

# 네이버 클로바 스튜디오 (비워 두면 규칙 기반 대본으로 대체)
NAVER_API_KEY=
# HCX_ENDPOINT=https://clovastudio.stream.ntruss.com/v1/chat-completions/HCX-003

# 음성/영상 생성: local = 이 PC에서 처리(개발용), runpod = RunPod 서버리스 GPU
# TTS_PROVIDER=wemeet = 우리가 학습한 한국어 TTS 서버 (C:\WE_MEET\tts_server, 먼저 run_server.ps1로 띄운다)
TTS_PROVIDER=local
VIDEO_PROVIDER=local

# TTS_PROVIDER=wemeet일 때 쓰는 TTS 서버 주소, API 키(서버에 WEMEET_API_KEY를 설정했을 때만), 생성 요청 최대 대기(초)
WEMEET_TTS_URL=http://127.0.0.1:8100
WEMEET_TTS_API_KEY=
WEMEET_TTS_TIMEOUT=300

# TTS_PROVIDER=wemeet일 때 S3Gen 음색 학습: 목소리 등록 뒤 녹음으로 사용자별 어댑터를 학습하고, 더 닮았을 때만 적용한다
# 학습은 torch가 있는 Wemeet-cb 환경 python으로 연구 코드(AI_test/chatterbox_lora)를 돌린다. 한 번에 약 5분, GPU 최대 약 9GB(TTS 서버 포함)
S3GEN_TRAINING=false
WEMEET_TRAIN_PYTHON=C:\Users\swlab\miniconda3\envs\Wemeet-cb\python.exe
WEMEET_LORA_CODE_DIR=C:\WE_MEET\AI_test
# 배치 8은 12GB GPU에서 TTS 서버와 함께 돌리면 메모리 한계에 닿는다
S3GEN_STEPS=1000
S3GEN_BATCH_SIZE=4
# 적용 기준 (화자 유사도 상승폭): VoiceEncoder가 이만큼 오르고 WavLM이 이만큼 이상일 때만 어댑터를 쓴다
S3GEN_MIN_VE_GAIN=0.005
S3GEN_MIN_SV_GAIN=0
RUNPOD_API_KEY=
RUNPOD_TTS_ENDPOINT_ID=
RUNPOD_VIDEO_ENDPOINT_ID=
# GPU 초당 단가(USD). 작업별 비용 기록에 쓰인다
RUNPOD_COST_PER_SECOND=0

# 목소리 등록에 필요한 녹음 길이(초). 테스트할 때는 30 정도로 줄여도 된다
VOICE_TARGET_SECONDS=180
# 시청 링크 유효 기간(일)
SHARE_LINK_DAYS=30

# 데이터(SQLite DB, 녹음, 사진, 영상) 저장 위치. 기본값은 backend/data
# DATA_DIR=
# DATABASE_URL=sqlite:///C:/ongi-data/ongi.db
