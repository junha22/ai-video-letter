# 온기 웹(Next.js) 이미지. 저장소 루트에서:
#   docker build -f Dockerfile.web --build-arg BACKEND_URL=http://ongi-api --build-arg NEXT_PUBLIC_KAKAO_JS_KEY=<JavaScript 키> -t ongi-web .
# /api/* 요청은 src/app/api/[...path]/route.ts가 BACKEND_URL로 넘긴다. 실행할 때 읽으므로 컨테이너 환경 변수로 바꿀 수 있다
# (Azure: 같은 Container Apps 환경의 api 앱 이름. 브라우저는 웹 주소 하나만 보므로 세션 쿠키가 그대로 동작한다)
FROM node:20-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# 카카오톡 공유 버튼의 JavaScript 키 (공개용 키). NEXT_PUBLIC_ 값은 빌드할 때 화면 코드에 들어가서 실행할 때는 바꿀 수 없다.
# 비어 있으면 버튼 대신 휴대폰 공유 창·문자·링크 복사만 보인다
ARG NEXT_PUBLIC_KAKAO_JS_KEY=
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ARG BACKEND_URL=http://ongi-api
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 BACKEND_URL=$BACKEND_URL
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
